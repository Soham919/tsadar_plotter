#     hydrogen = PlasmaSpecies(name = 'hydrogen', Z = ZH, m = mp, T_eV = TH_eV[i], n_cm3 = fH * (ne_cm3 / Zbar), ud = ud_H*(10**4))
#     helium = PlasmaSpecies(name = 'helium', Z = ZHe, m = 14.0 * mp, T_eV = THe_eV[i], n_cm3 = (1-fH) * (ne_cm3 / Zbar), ud = ud_He*(10**4))
#     ions  = [hydrogen, helium]

for f in fH:
    Zbar = ZH * f + ZHe * (1-f)
    electron = PlasmaSpecies(name = 'electron', Z = -1, m = me, T_eV = Te_eV, n_cm3 = ne_cm3, ud = ud_e*(10**4))
    hydrogen = PlasmaSpecies(name = 'hydrogen', Z = ZH, m = mp, T_eV = TH_eV, n_cm3 = f * (ne_cm3 / Zbar), ud = ud_H*(10**4))
    helium = PlasmaSpecies(name = 'helium', Z = ZHe, m = 4.0 * mp, T_eV = THe_eV, n_cm3 = (1-f) * (ne_cm3 / Zbar), ud = ud_He*(10**4))
    ions  = [hydrogen, helium]

    # ============================================================
    # Calculate everything
    # ============================================================

    Result = thomson_structure_factor(k=k, phase_velocity = phase_velocity, electron = electron, ions = ions)
    results.append(Result)

spectra = np.array([result["S_total"] for result in results])
eps = np.array([result["epsilon"] for result in results])
# ============================================================
# Plotting
# ============================================================

ion_mask = np.abs(phase_velocity) <= 1.0e6

from matplotlib.colors import LogNorm

fig, ax = plt.subplots(1 , 3, figsize=(14, 8))

pcm = ax[0, 0].pcolormesh(phase_velocity[ion_mask]/1e4, fH, spectra[:, ion_mask],
    shading='auto',
    cmap='turbo',          # or inferno, plasma, viridis...
